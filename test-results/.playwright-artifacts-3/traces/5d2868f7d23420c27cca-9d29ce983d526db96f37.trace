6)","font-size":"13","font-weight":"700","letter-spacing":"2.5"},"UNITED STATES"]]]]],["SECTION",{"class":"py-20 md:py-24 bg-surface"},["DIV",{"class":"container-page grid lg:grid-cols-3 gap-12"},["DIV",{},["DIV",{"class":"text-xs font-semibold text-accent uppercase tracking-wider mb-2"},"FAQ"],["H2",{"class":"text-3xl md:text-4xl font-display text-foreground leading-tight"},"Answers before you ask."],["P",{"class":"mt-4 text-muted-foreground text-sm"},"Still curious? Our team is happy to jump on a quick call."]],["DIV",{"class":"lg:col-span-2"},["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"How quickly does the team respond?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"Most inquiries receive a response within two business days, Monday through Friday. Urgent requests submitted during business hours are typically answered the same day."]]],["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"Are consultations free?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"Yes. The initial conversation, discovery call, and preliminary Local SEO review are complimentary. There's no obligation to move forward."]]],["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"Do you work with businesses of all sizes?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"We work with single-location businesses, growing multi-location brands, franchises, and agencies. If Local SEO is part of your growth plan, we can help."]]],["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"Are services available for multiple locations?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"Absolutely. Multi-location and franchise Local SEO is one of our specialties, with rollup reporting and per-location strategies designed for scale."]]],["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"Can I schedule a software demonstration?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"Yes. Choose 'Local SEO Software Demo' as your interest and we'll book a guided walkthrough tailored to your business or client base."]]],["DIV",{"class":"border-b border-border"},["BUTTON",{"class":"w-full flex items-center justify-between py-5 text-left"},["SPAN",{"class":"font-medium text-foreground pr-6"},"Can you review our existing Local SEO reports?"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-5 h-5 text-muted-foreground transition-transform","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["DIV",{"class":"grid transition-all duration-300 grid-rows-[0fr]"},["DIV",{"class":"overflow-hidden text-sm text-muted-foreground leading-relaxed"},"Bring what you have. We're happy to review current reports, audits, or rankings and share an independent perspective during your consultation."]]]]]],["SECTION",{"class":"py-16 md:py-20"},["DIV",{"class":"container-page"},["DIV",{"class":"relative rounded-3xl overflow-hidden bg-primary text-primary-foreground p-10 md:p-16 shadow-lift"},["DIV",{"aria-hidden":"true","class":"absolute -right-24 -top-24 w-96 h-96 rounded-full bg-acc